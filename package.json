{
  "name": "prori-ai",
  "version": "0.1.0",
  "description": "Official JavaScript / TypeScript SDK for Prori (prori.ai) — product directory, daily launches, leaderboards, topics, and creator campaigns.",
  "license": "MIT",
  "author": "Prori <hello@prori.ai>",
  "homepage": "https://prori.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prori-ai/prori-js.git"
  },
  "bugs": {
    "url": "https://github.com/prori-ai/prori-js/issues"
  },
  "keywords": [
    "prori",
    "prori.ai",
    "sdk",
    "api",
    "api-client",
    "product-discovery",
    "product-launch",
    "creator-marketing",
    "creator-ads",
    "brand-growth",
    "creative-studio",
    "ai-agent",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
