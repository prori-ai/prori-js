{
  "name": "prori-ai",
  "version": "0.2.0",
  "description": "Official JavaScript / TypeScript SDK and CLI for Prori (prori.ai) — Tools Gateway, product catalogue, and campaigns.",
  "license": "MIT",
  "author": "Prori <hello@prori.ai>",
  "homepage": "https://prori.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prori-ai/prori-js.git"
  },
  "bugs": {
    "url": "https://github.com/prori-ai/prori-js/issues"
  },
  "keywords": [
    "prori",
    "prori.ai",
    "sdk",
    "api",
    "api-client",
    "brands",
    "creators",
    "ai-agents",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "prori": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
